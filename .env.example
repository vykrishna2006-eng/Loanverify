# ── PostgreSQL (loan data) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://loanverify:loanverify_secret@localhost:5432/loanverify

# ── MongoDB (authentication only) ────────────────────────────────────────────
# Local development:
MONGODB_URL=mongodb://localhost:27017
# MongoDB Atlas (production):
# MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=loanverify_auth

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_character_string_in_production
ENVIRONMENT=development
DEBUG=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local:
CORS_ORIGINS=http://localhost:3000
# Production (add your Vercel URL):
# CORS_ORIGINS=https://loanverify-ai.vercel.app,http://localhost:3000

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
# Production: REACT_APP_API_URL=https://loanverify-backend.onrender.com
