{
  "framework": "create-react-app",
  "buildCommand": "CI='' npm run build",
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "CI": "",
    "GENERATE_SOURCEMAP": "false",
    "REACT_APP_API_URL": "https://loanverify-backend.onrender.com"
  }
}
